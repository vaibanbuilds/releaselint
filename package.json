{
  "name": "releaselint",
  "version": "0.1.1",
  "description": "Release readiness linter for GitHub projects.",
  "type": "module",
  "homepage": "https://github.com/vaibanbuilds/releaselint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaibanbuilds/releaselint.git"
  },
  "bugs": {
    "url": "https://github.com/vaibanbuilds/releaselint/issues"
  },
  "bin": {
    "releaselint": "./src/cli.js"
  },
  "scripts": {
    "check": "node src/cli.js check --fixture fixtures/sample-release.json --format markdown --no-fail",
    "check:json": "node src/cli.js check --fixture fixtures/sample-release.json --format json --no-fail",
    "check:passing": "node src/cli.js check --fixture fixtures/passing-release.json --version-file fixtures/package-v1.2.1.json --format markdown --no-fail"
  },
  "keywords": [
    "release",
    "github",
    "changelog",
    "semver",
    "ci",
    "lint"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
